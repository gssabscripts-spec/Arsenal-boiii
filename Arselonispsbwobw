local function button(text,y,callback)
 local b=Instance.new("TextButton",main)
 b.Size=UDim2.new(1,-24,0,36);b.Position=UDim2.new(0,12,0,y)
 b.BackgroundColor3=off;b.TextColor3=Color3.new(1,1,1)
 b.Text=text;b.Font=Enum.Font.GothamMedium;b.TextSize=12
 b.AutoButtonColor=true;b.ZIndex=7;corner(b,8)
 b.Activated:Connect(callback)
 return b
end

local function toggle(name,y,callback)
 local state=false
 local b
 b=button(name.."   [OFF]",y,function()
  state=not state
  b.Text=name..(state and "   [ON]" or "   [OFF]")
  b.BackgroundColor3=state and Color3.fromRGB(75,42,115) or off
  callback(state)
 end)
 return b
end

toggle("Aim Assist",82,function(v) aim=v end)
